<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="NuGet.Packaging" HintPath="$(MSBuildSDKsPath)/../NuGet.Packaging.dll" />
    <Reference Include="NuGet.Common" HintPath="$(MSBuildSDKsPath)/../NuGet.Common.dll" />
    <Reference Include="NuGet.Frameworks" HintPath="$(MSBuildSDKsPath)/../NuGet.Frameworks.dll" />
    <Reference Include="NuGet.Versioning" HintPath="$(MSBuildSDKsPath)/../NuGet.Versioning.dll" />
    <Reference Include="NuGet.Configuration" HintPath="$(MSBuildSDKsPath)/../NuGet.Configuration.dll" />
  </ItemGroup>
</Project>
